---
import { getCollection } from "astro:content";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import AccommodationBanner from "../components/AccommodationBanner.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contact, membershipBenefits } from "../data/site";

const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'America/Sao_Paulo' }).format(new Date());
const upcomingEvents = (await getCollection('events'))
  .filter(({ data }) => (data.endDate ?? data.startDate).toISOString().slice(0, 10) >= today)
  .filter(({ id }) => id !== 'dia-das-criancas')
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
  .slice(0, 1);
const formatDate = (date: Date) => new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(date);
const homeSchema = {
  "@context": "https://schema.org", "@type": "WebSite",
  name: "Clube dos Oficiais CBMDF", url: "https://clubedosoficiaiscbmdf.com.br/", inLanguage: "pt-BR",
};
---

<BaseLayout title="Clube dos Oficiais CBMDF | Lazer e hospedagem em Brasília" description="Conheça o Clube dos Oficiais do Corpo de Bombeiros do DF. Acomodações, lazer, convivência e programação para aproveitar em Brasília." schema={homeSchema}>
  <Header />
  <main class="home-clean">
    <div class="container">
      <header class="welcome">
        <div><p class="eyebrow">CLUBE DOS OFICIAIS DO CORPO DE BOMBEIROS DO DF</p><h1>Seu lugar para estar bem.</h1><p>Lazer, descanso e bons encontros em Brasília.</p></div>
        <a class="text-link" href="/localizacao">Venha conhecer <span aria-hidden="true">↗</span></a>
      </header>
      <section class="club-life" aria-labelledby="club-life-title">
        <a class="club-photo" href="/estrutura" aria-label="Conhecer a estrutura do clube"><img src="/images/banner-piscina.jpg" alt="Piscina e área de lazer do Clube dos Oficiais CBMDF" width="800" height="520" loading="eager" fetchpriority="high" /></a>
        <div class="club-copy"><p class="eyebrow">APROVEITE O SEU CLUBE</p><h2 id="club-life-title">Mais tempo para o que faz bem.</h2><p>Um mergulho, uma partida entre amigos ou um encontro em família. Conheça nossos espaços e planeje sua próxima visita.</p><p class="club-spaces">Piscinas · Esporte · Churrasqueiras · Convivência</p><a class="text-link" href="/estrutura">Explore a estrutura <span aria-hidden="true">→</span></a></div>
      </section>
      <section class="home-kids-banner" aria-label="Banner da festa do Dia das Crianças">
        <a class="home-kids-banner__poster" href="/eventos/dia-das-criancas.html" aria-label="Ver detalhes da festa do Dia das Crianças">
          <img
            src="/images/evento-dia-criancas-2026.jpeg"
            alt="Cartaz da festa do Dia das Crianças do Clube dos Oficiais CBMDF — clique para ver detalhes"
            loading="eager"
          />
        </a>
        <div class="home-kids-banner__content">
          <p class="home-kids-banner__eyebrow">Diversão para toda a família</p>
          <h2>Dia das Crianças</h2>
          <p>Prepare a criançada: <strong>12 de outubro, das 10h às 16h</strong>, tem animação, brinquedos infláveis, algodão-doce e pipoca. Diversão para curtir juntinhos em família!</p>
          <a class="home-kids-banner__link" href="/eventos/dia-das-criancas.html">Confira os detalhes <span aria-hidden="true">→</span></a>
        </div>
      </section>
      {upcomingEvents.map((event) => (
        <section class="next-event" data-event-until={(event.data.endDate ?? event.data.startDate).toISOString().slice(0, 10)} aria-labelledby={`event-${event.id}`}>
          <a class="event-poster" href={`/eventos/${event.id}`} aria-label={`Ver detalhes: ${event.data.title}`}><img src={event.data.cover} alt={`Cartaz: ${event.data.title}`} loading="lazy" width="300" height="300" /></a>
          <div class="event-copy">
            <p class="eyebrow">NA AGENDA DO CLUBE</p><h2 id={`event-${event.id}`}>{event.data.title}</h2>
            <p class="event-date"><time datetime={event.data.startDate.toISOString().slice(0, 10)}>{formatDate(event.data.startDate)}</time>{event.data.time && ` · ${event.data.time}`}</p>
            <p>{event.data.summary}</p><a class="text-link" href={`/eventos/${event.id}`}>Confira a programação <span aria-hidden="true">→</span></a>
          </div>
          <a class="agenda-link" href="/eventos">Ver agenda completa ↗</a>
        </section>
      ))}
      <AccommodationBanner />
      <section class="benefits" aria-labelledby="benefits-title">
        <p class="eyebrow">MAIS MOTIVOS PARA FAZER PARTE</p>
        <h2 id="benefits-title">Benefícios de ser associado</h2>
        <p class="section-intro">Espaços e experiências para aproveitar o clube do seu jeito.</p>
        <div class="benefits-grid">
          {membershipBenefits.map((benefit, index) => <article><span class="benefit-number" aria-hidden="true">0{index + 1}</span><h3>{benefit.title}</h3><p>{benefit.description}</p></article>)}
        </div>
      </section>

      <section class="membership" aria-labelledby="membership-title">
        <div><p class="eyebrow">FAÇA PARTE</p><h2 id="membership-title">Bons momentos começam aqui.</h2><p>Conheça os benefícios e veja como se associar ao clube.</p></div>
        <a class="join-button" href="/associe-se" data-track-click="associate_cta_click" data-track-location="home-membership">Quero me associar <span aria-hidden="true">→</span></a>
      </section>
      <section class="quick-access" aria-labelledby="access-title">
        <p class="eyebrow">INFORMAÇÕES SEM COMPLICAÇÃO</p>
        <h2 id="access-title">Acesso rápido para associados e interessados</h2>
        <div class="access-grid">
          <a href="/associe-se"><h3>Associe-se <span aria-hidden="true">↗</span></h3><p>Documentos e orientações para fazer parte do clube.</p></a>
          <a href="/diretoria"><h3>Diretoria <span aria-hidden="true">↗</span></h3><p>Conheça a gestão e os conselhos do clube.</p></a>
          <a href="/regulamentos"><h3>Regulamentos <span aria-hidden="true">↗</span></h3><p>Estatuto, formulários e documentos oficiais.</p></a>
          <a href="/contatos"><h3>Contatos <span aria-hidden="true">↗</span></h3><p>Canais de atendimento da secretaria.</p></a>
        </div>
      </section>
      <nav class="useful-links" aria-label="Informações e serviços do clube">
        <div><h2>O clube, à sua mão.</h2><p>Encontre o que precisa para sua visita.</p></div>
        <ul>
          <li><a href="/horarios">Horários <span aria-hidden="true">↗</span></a></li>
          <li><a href="/localizacao">Como chegar <span aria-hidden="true">↗</span></a></li>
          <li><a href="/eventos">Agenda e eventos <span aria-hidden="true">↗</span></a></li>
          <li><a href="/noticias">Informativos <span aria-hidden="true">↗</span></a></li>
          <li><a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" data-track-click="whatsapp_click" data-track-location="home-services">Fale com a secretaria <span aria-hidden="true">↗</span></a></li>
        </ul>
      </nav>
    </div>
  </main>
  <Footer />
</BaseLayout>
<script>
  // Hide expired highlights even between static deployments.
  const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'America/Sao_Paulo' }).format(new Date());
  document.querySelectorAll<HTMLElement>('[data-event-until]').forEach((event) => {
    if (event.dataset.eventUntil && event.dataset.eventUntil < today) event.hidden = true;
  });
</script>
<style>
  .club-numbers{padding:12px 0 36px;border-bottom:1px solid #e4e7ea}.club-numbers h2,.benefits h2,.quick-access h2{font-size:clamp(23px,2.6vw,29px);line-height:1.25;letter-spacing:-.6px;margin:8px 0 12px}.numbers-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:26px}.numbers-row>div{display:flex;flex-direction:column;padding-left:24px;border-left:2px solid #eee3e2}.numbers-row dt{font-size:13px;color:#69717a;margin-top:6px}.numbers-row dd{order:-1;font-size:clamp(25px,3vw,36px);font-weight:750;letter-spacing:-1px;color:#92232b}.benefits{padding:40px 0 32px}.section-intro{font-size:14px;color:#69717a}.benefits-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px;margin-top:28px}.benefit-number{display:inline-flex;width:34px;height:34px;border-radius:50%;align-items:center;justify-content:center;background:#f7eeee;color:#92232b;font-size:11px;font-weight:700}.benefits-grid h3{font-size:16px;line-height:1.4;margin:14px 0 8px}.benefits-grid p,.access-grid p{font-size:13px;color:#69717a;line-height:1.7}.quick-access{padding-top:44px}.access-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:24px}.access-grid>a{padding:22px 20px;background:#f8f9fa;border:1px solid #e7ebee;border-radius:12px;transition:background .15s,border-color .15s}.access-grid>a:hover{background:#fcf5f4;border-color:#dcb5b7}.access-grid h3{display:flex;justify-content:space-between;gap:12px;font-size:16px;margin-bottom:10px}.access-grid h3 span{color:#98232d}.welcome+.club-life{padding:8px 0 32px}.next-event{margin-bottom:34px}
  @media(max-width:900px){.benefits-grid,.access-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.numbers-row{gap:14px}.numbers-row>div{padding-left:14px}}
  @media(max-width:600px){.numbers-row{grid-template-columns:1fr 1fr;gap:22px}.club-numbers{padding-bottom:28px}.benefits{padding-top:30px}.benefits-grid{gap:24px 18px}.benefits-grid h3{font-size:15px}.access-grid{gap:12px}.access-grid>a{padding:18px 14px}.quick-access{padding-top:32px}.quick-access h2{max-width:330px}.welcome+.club-life{padding-top:0}.next-event{margin-bottom:28px}}
  @media(max-width:380px){.benefits-grid,.access-grid{grid-template-columns:1fr}}
  @media(prefers-reduced-motion:reduce){.access-grid>a{transition:none}}
  .home-clean{background:#fff;padding-bottom:48px;color:#292e35}.welcome{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:36px 0 28px}.eyebrow{font-size:10px;font-weight:750;letter-spacing:1.7px;color:#98232d}.welcome h1{font-size:clamp(28px,3.4vw,40px);line-height:1.2;letter-spacing:-1px;margin:9px 0}.welcome p:last-child{color:#69717a;font-size:16px}.text-link{display:inline-flex;align-items:center;gap:16px;color:#92232b;font-size:14px;font-weight:700;white-space:nowrap}.text-link:hover{text-decoration:underline;text-underline-offset:5px}.next-event{display:grid;grid-template-columns:175px minmax(0,1fr) auto;align-items:center;gap:30px;padding:26px 0 30px;border-bottom:1px solid #e4e7ea}.next-event[hidden]{display:none}.event-poster img{width:175px;height:175px;object-fit:contain;border-radius:10px;background:#f5f5f5}.event-copy h2{font-size:26px;line-height:1.2;margin:7px 0 8px;letter-spacing:-.5px}.event-date{font-weight:650;color:#3d5365;font-size:14px}.event-copy>p:not(.eyebrow):not(.event-date){color:#69717a;font-size:14px;margin:10px 0 14px;max-width:540px}.agenda-link{align-self:end;font-size:12px;color:#69717a;text-decoration:underline;text-underline-offset:4px}.club-life{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:54px;padding:52px 0}.club-photo img{display:block;width:100%;height:310px;object-fit:cover;border-radius:16px}.club-copy h2{font-size:clamp(27px,3vw,36px);line-height:1.17;letter-spacing:-.9px;margin:12px 0 20px;max-width:370px}.club-copy>p:not(.eyebrow){font-size:15px;color:#69717a;line-height:1.8}.club-copy .club-spaces{margin:18px 0 24px;font-size:12px!important;color:#4e5963!important}.membership{display:flex;align-items:center;justify-content:space-between;gap:28px;background:#f5f2ee;border-radius:16px;padding:32px 36px}.membership h2{font-size:25px;line-height:1.2;letter-spacing:-.5px;margin:8px 0 10px}.membership p:last-child{font-size:14px;color:#69717a}.join-button{display:inline-flex;align-items:center;justify-content:space-between;gap:32px;padding:15px 22px;background:#a71f27;color:white;border-radius:9px;font-size:14px;font-weight:700;white-space:nowrap}.join-button:hover{background:#80181f}.useful-links{display:grid;grid-template-columns:1fr 1.7fr;gap:40px;margin-top:44px;padding-top:12px}.useful-links h2{font-size:21px;letter-spacing:-.4px}.useful-links p{font-size:13px;color:#69717a;margin-top:8px}.useful-links ul{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 24px}.useful-links a{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 0;border-bottom:1px solid #e4e7ea;font-size:13px}.useful-links a:hover{color:#a71f27}.useful-links a span{color:#98232d}
  @media(max-width:900px){.next-event{grid-template-columns:150px 1fr;gap:22px}.event-poster img{width:150px;height:150px}.agenda-link{grid-column:2}.club-life{gap:30px}.useful-links{grid-template-columns:1fr}.useful-links ul{gap:0 28px}}
  @media(max-width:600px){.welcome{padding-top:24px;display:block}.welcome>.text-link{margin-top:16px}.eyebrow{font-size:9px;letter-spacing:1.2px}.next-event{grid-template-columns:100px minmax(0,1fr);gap:18px;padding-top:8px}.event-poster{align-self:start}.event-poster img{width:100px;height:130px}.event-copy h2{font-size:23px}.event-date{font-size:12px}.agenda-link{grid-column:1/-1}.club-life{grid-template-columns:1fr;gap:24px;padding:36px 0}.club-photo img{height:230px}.club-copy h2{max-width:300px}.membership{display:block;padding:26px}.membership h2{font-size:24px}.join-button{margin-top:22px;width:100%}.useful-links{margin-top:28px;gap:16px}.useful-links ul{grid-template-columns:1fr 1fr;gap:0 18px}.useful-links a{font-size:12px}.home-clean{padding-bottom:32px}}
</style>
