---
import { getCollection, type CollectionEntry } from "astro:content";
import Breadcrumb from "../components/Breadcrumb.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LeadershipTable from "../components/LeadershipTable.astro";
import SectionHeader from "../components/SectionHeader.astro";
import TrustStats from "../components/TrustStats.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const breadcrumbs = [
  { label: "Início", href: "/" },
  { label: "Diretoria" },
];

const leadership: CollectionEntry<"leadership">[] = (await getCollection("leadership")).sort(
  (a: CollectionEntry<"leadership">, b: CollectionEntry<"leadership">) => a.data.order - b.data.order,
);
const executiveBoard: CollectionEntry<"leadership">[] = leadership.filter(
  (entry: CollectionEntry<"leadership">) => entry.data.board === "diretoria-executiva",
);
const deliberativeBoard: CollectionEntry<"leadership">[] = leadership.filter(
  (entry: CollectionEntry<"leadership">) => entry.data.board === "conselho-deliberativo",
);
const fiscalBoard: CollectionEntry<"leadership">[] = leadership.filter(
  (entry: CollectionEntry<"leadership">) => entry.data.board === "conselho-fiscal",
);

const boardStats = [
  { value: "2026/2027", label: "Mandato publicado", note: "Gestão vigente apresentada no portal." },
  { value: `${executiveBoard.length}`, label: "Integrantes na diretoria executiva" },
  { value: `${deliberativeBoard.length}`, label: "Integrantes no conselho deliberativo" },
  { value: `${fiscalBoard.length}`, label: "Integrantes no conselho fiscal" },
];
---

<BaseLayout
  title="Diretoria"
  description="Gestão COCBMDF 2026/2027 com diretoria executiva, conselho deliberativo e conselho fiscal."
  breadcrumbs={breadcrumbs}
>
  <Header />
  <Breadcrumb items={breadcrumbs} />
  <main class="main-content">
    <div class="container">
      <section class="page-section">
        <SectionHeader
          title="Diretoria"
          level="h1"
          subtitle="Gestão COCBMDF 2026/2027 com organização colegiada, cargos executivos e governança institucional."
        />
        <div class="legacy-split diretoria-page__intro">
          <div>
            <p>
              A estrutura de governança do clube está organizada em diretoria executiva, conselho deliberativo e
              conselho fiscal, com definição pública de cargos, nomes e postos.
            </p>
            <p class="page-copy-spaced">
              A apresentação abaixo reforça a autoridade institucional e facilita a consulta por associados,
              convidados e interessados em acompanhar a gestão vigente.
            </p>
          </div>
          <TrustStats items={boardStats} className="trust-stats--compact" />
        </div>
        <div class="legacy-table-stack">
          <LeadershipTable
            title="Diretoria Executiva"
            description="Responsável pela condução administrativa, financeira, social e operacional da gestão."
            members={executiveBoard}
          />
          <LeadershipTable
            title="Conselho Deliberativo"
            description="Colegiado de apoio institucional e deliberação das pautas regimentais."
            members={deliberativeBoard}
          />
          <LeadershipTable
            title="Conselho Fiscal"
            description="Colegiado destinado ao acompanhamento e à fiscalização dos controles institucionais."
            members={fiscalBoard}
          />
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
